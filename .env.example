# Contraseña del panel /admin (obligatorio cambiarla)
ADMIN_PASSWORD=pon-aqui-una-contraseña-larga
# Opcional: clave larga y aleatoria para firmar la sesión del admin
SESSION_SECRET=
# Opcional: clave de la API de Claude para que Abi responda preguntas libres y para revisar fotos del mapa
ANTHROPIC_API_KEY=
# Carpeta donde se guardan la base de datos y las fotos (en el hosting, un disco persistente)
DB_FILE=./data/beegreen.db
UPLOAD_DIR=./data/uploads
PORT=3000
